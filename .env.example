PYTHONDONTWRITEBYTECODE=1

# ── AI Tier ────────────────────────────────────────────────────────────────
# Controls which AI backend PhantomAI uses.
#
#   claude_code →  Claude Code CLI — uses your Pro/Max subscription (ZERO extra cost) ← RECOMMENDED
#   free        →  Ollama (local model, ZERO API cost)
#   basic       →  Claude Haiku only (cheapest paid API option)
#   pro         →  Claude Haiku + Sonnet (best quality API option)
#   auto        →  claude CLI found = claude_code; API key = pro; else = free  [default]
#
# ── How auto-detection works ───────────────────────────────────────────────
# 1. Is `claude` CLI installed?  → claude_code (your Pro plan covers it)
# 2. Is ANTHROPIC_API_KEY set?   → pro         (API billing)
# 3. Is Ollama running locally?  → free        (zero cost)
#
AI_TIER=auto

# ── Free Tier: Ollama settings ─────────────────────────────────────────────
# Used when AI_TIER=free (or AI_TIER=auto with no API key).
# Install Ollama: https://ollama.com
# Pull a model:   ollama pull llama3.2
#
# Recommended models (best to worst for security tasks):
#   llama3.1:8b    — best reasoning, ~5 GB VRAM
#   llama3.2       — fast, light, decent JSON output, ~2 GB VRAM  [default]
#   mistral        — good JSON compliance
#   qwen2.5:7b     — strong reasoning, good for report generation
#
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Paid Tiers: Anthropic Claude API ──────────────────────────────────────
# Used when AI_TIER=basic or AI_TIER=pro (or AI_TIER=auto with a key set).
# Get your key: https://console.anthropic.com/
#
ANTHROPIC_API_KEY=your_api_key_here

# ── Optional: Reverse WHOIS (Whoxy) ───────────────────────────────────────
# Used by Phase 1 OSINT to find related domains via company name.
# Free tier available at https://www.whoxy.com/
# Leave blank to fall back to amass intel (slower, less accurate).
#
WHOXY_API_KEY=

# ── Optional: Shodan ──────────────────────────────────────────────────────
# Used by Phase 1 OSINT to pull Shodan's service/banner/CVE index.
# Free API key available at https://account.shodan.io/
# Without a key this step is silently skipped.
#
SHODAN_API_KEY=

# ── Optional: GitHub Token ────────────────────────────────────────────────
# Used by Phase 1 leak recon to run GitHub dork searches.
# Without a token: 3 unauthenticated dorks run (10 req/min rate limit).
# With a token   : all 8 dorks run at full rate (5000 req/hr).
# Create a classic token (no scopes needed for public search) at:
# https://github.com/settings/tokens
#
GITHUB_TOKEN=

# ── Optional: SecurityTrails ──────────────────────────────────────────────
# Used by Phase 1 leak recon to pull historical subdomain data.
# Free tier (50 queries/month) at https://securitytrails.com/
# Leave blank to skip; passive sources (crt.sh etc.) still run without it.
#
SECURITYTRAILS_API_KEY=
